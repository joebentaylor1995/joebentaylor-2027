{
	"name": "tackl",
	"version": "5.2.1",
	"private": true,
	"description": "The ultimate Next.js starter kit!",
	"license": "MIT",
	"browserslist": [
		"baseline widely available"
	],
	"engines": {
		"node": ">=24.0.0"
	},
	"author": "joebentaylor1995",
	"sideEffects": [
		"*.css",
		"*.scss",
		"src/components/AnimationPlugins/**"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/12-studio/tackl"
	},
	"scripts": {
		"dev": "bun run styles && next dev --turbopack",
		"build": "bun run styles && next build",
		"start": "next start",
		"lint": "biome check . && stylelint \"**/*.scss\"",
		"lint:fix": "biome check --write . && stylelint \"**/*.scss\" --fix",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"type-check": "tsc --noEmit",
		"sanity:import": "bun scripts/sanity-import.ts",
		"sanity:deploy-schema": "sanity schema deploy",
		"styles": "bun scripts/build-styles.ts",
		"storybook": "bun run styles && storybook dev -p 6006",
		"build-storybook": "bun run styles && storybook build",
		"serve": "serve ./out",
		"commit": "node .gitmessage.js",
		"prepare": "husky && git config --local core.editor \"$(git rev-parse --show-toplevel)/.husky/commit-editor\"",
		"test": "playwright test",
		"lighthouse": "bun run build && lhci autorun",
		"outdated": "bunx npm-check-updates"
	},
	"dependencies": {
		"@calcom/embed-react": "^1.5.3",
		"@datocms/cda-client": "^0.3.2",
		"@gsap/react": "^2.1.2",
		"@sanity/color-input": "^6.1.8",
		"@sanity/icons": "^5.2.3",
		"@sanity/ui": "^4.4.9",
		"@sanity/vision": "^6.18.0",
		"@sanity/visual-editing": "^6.1.3",
		"graphql": "^17.0.2",
		"graphql-tag": "^2.12.7",
		"gsap": "^3.15.0",
		"lenis": "^1.3.26",
		"matter-js": "^0.20.0",
		"mediabunny": "^1.61.6",
		"next": "^16.4.0",
		"next-sanity": "^13.3.4",
		"prompts": "^2.4.2",
		"react": "^19.3.0",
		"react-datocms": "^8.1.2",
		"react-dom": "^19.3.0",
		"sanity": "^6.18.0",
		"three": "^0.186.1"
	},
	"overrides": {
		"lighthouse": "13.5.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@lhci/cli": "^0.15.1",
		"@playwright/test": "^1.64.0",
		"@storybook/addon-docs": "^10.6.1",
		"@storybook/addon-links": "^10.6.1",
		"@storybook/addon-onboarding": "^10.6.1",
		"@storybook/addon-themes": "^10.6.1",
		"@storybook/nextjs": "^10.6.1",
		"@types/matter-js": "^0.20.2",
		"@types/node": "^26.6.5",
		"@types/react": "^19.3.0",
		"@types/three": "^0.186.0",
		"ajv": "^8.20.0",
		"ajv-keywords": "^5.1.0",
		"husky": "^9.1.7",
		"sass-embedded": "^1.105.1",
		"storybook": "^10.6.1",
		"stylelint": "^17.16.0",
		"stylelint-config-standard-scss": "^17.0.0",
		"stylelint-value-no-unknown-custom-properties": "^6.1.1",
		"typescript": "~7.0.2"
	}
}
