# Shared Environment Variables
NEXT_PUBLIC_SITE_URL=https://joebentaylor.co.uk

# Analytics — Google Analytics 4 measurement ID (G-XXXXXXX). Leave empty to
# switch analytics off; when set, it loads only after cookie consent.
NEXT_PUBLIC_GA_ID=

# CMS — Sanity
# Run `bunx sanity init --env .env` to create/link a project and fill these in
NEXT_PUBLIC_SANITY_PROJECT_ID=CHANGE_ME
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-06-01
# Viewer token for draft preview (server-only) — create at sanity.io/manage
SANITY_API_READ_TOKEN=

# Media — the R2 media Worker (workers/media) that serves Sanity video/file
# assets from Cloudflare R2. Leave empty to serve files from Sanity's CDN.
# e.g. https://joebentaylor-media.<account>.workers.dev — see docs/Sanity/R2Media.md
NEXT_PUBLIC_MEDIA_URL=
